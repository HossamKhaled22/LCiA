<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Validation – Phase 0 Recall@K"
        Width="1180" Height="720"
        MinWidth="1120" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="True">

  <Window.Resources>
    <!-- Theme palette (lifted from SmartMatch for visual consistency) -->
    <SolidColorBrush x:Key="AccentBrush" Color="#0078D4" />
    <SolidColorBrush x:Key="AccentLightBrush" Color="#E8F2FC" />
    <SolidColorBrush x:Key="HeaderBg" Color="#F5F6F7" />
    <SolidColorBrush x:Key="BorderBrush" Color="#D1D5DB" />
    <SolidColorBrush x:Key="SectionBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SubtleFg" Color="#6B7280" />
    <SolidColorBrush x:Key="HitBrush" Color="#16A34A" />
    <SolidColorBrush x:Key="MissBrush" Color="#DC2626" />

    <Style x:Key="RoundedButton" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="14,6" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Opacity" Value="0.88" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SubtleButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentLightBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SegmentRadio" TargetType="RadioButton">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="bd" Background="Transparent"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1,1,0,1"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontWeight" Value="SemiBold" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentLightBrush}" />
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsChecked" Value="True" />
                  <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentBrush}" />
                <Setter TargetName="bd" Property="Opacity" Value="0.88" />
              </MultiTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Modern on/off toggle switch (replaces the legacy CheckBox look).
         A text label sits left of a pill track; when ON the track fills
         accent-blue, the knob slides right, and the label turns accent. -->
    <Style x:Key="ToggleSwitch" TargetType="ToggleButton">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource SubtleFg}" />
      <Setter Property="Background" Value="#CBD5E1" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <ContentPresenter VerticalAlignment="Center" Margin="0,0,8,0" />
              <Border x:Name="track" Width="40" Height="22" CornerRadius="11"
                      Background="{TemplateBinding Background}" VerticalAlignment="Center">
                <Border x:Name="knob" Width="16" Height="16" CornerRadius="8"
                        Background="White" HorizontalAlignment="Left"
                        VerticalAlignment="Center" Margin="3,0,0,0"
                        RenderTransformOrigin="0.5,0.5">
                  <Border.RenderTransform>
                    <TranslateTransform x:Name="knobShift" X="0" />
                  </Border.RenderTransform>
                  <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.25"
                                      BlurRadius="3" ShadowDepth="0.5" Direction="270" />
                  </Border.Effect>
                </Border>
              </Border>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="track" Property="Background"
                        Value="{StaticResource AccentBrush}" />
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="knobShift"
                                       Storyboard.TargetProperty="X"
                                       To="18" Duration="0:0:0.16" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="knobShift"
                                       Storyboard.TargetProperty="X"
                                       To="0" Duration="0:0:0.16" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="track" Property="Opacity" Value="0.88" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" /> <!-- Header -->
      <RowDefinition Height="Auto" /> <!-- Recall summary -->
      <RowDefinition Height="*" />    <!-- Results -->
      <RowDefinition Height="Auto" /> <!-- Footer -->
    </Grid.RowDefinitions>

    <!-- ── HEADER ─────────────────────────────────────────────────── -->
    <Border Grid.Row="0" Background="{StaticResource HeaderBg}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
            Padding="16,10">
      <!-- 3 aligned rows × 2 columns. Col 0 (*) holds the left labels and
           yields/ellipsizes first when the window narrows; col 1 (Auto) holds
           the settings + buttons and always gets its full width, so the
           right-hand controls never clip (mirrors the footer's * | Auto). -->
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />      <!-- left: yields / ellipsizes first when narrow -->
          <ColumnDefinition Width="Auto" />   <!-- right: always full width, never clips -->
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />   <!-- 0: Data Source   / Top · Min Score · Lang -->
          <RowDefinition Height="Auto" />   <!-- 1: Scope         / BIM context -->
          <RowDefinition Height="Auto" />   <!-- 2: Ground Truth  / Measure · Run -->
        </Grid.RowDefinitions>

        <!-- ── Row 0 · left: Data Source segmented buttons ─────────── -->
        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal"
                    VerticalAlignment="Center" Margin="0,0,0,8">
            <TextBlock Text="Data Source:" FontWeight="SemiBold" FontSize="12"
                       VerticalAlignment="Center" Width="100" Margin="0,0,10,0" />
            <Border CornerRadius="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="radio_a2_sphera" GroupName="DataSource"
                             Content="A2 – Sphera MLC" IsChecked="True"
                             Style="{StaticResource SegmentRadio}"
                             Checked="on_database_changed" />
                <RadioButton x:Name="radio_a1_sphera" GroupName="DataSource"
                             Content="A1 – Sphera MLC"
                             Style="{StaticResource SegmentRadio}"
                             Checked="on_database_changed" />
                <RadioButton x:Name="radio_a2_ecoinvent" GroupName="DataSource"
                             Content="A2 – ecoinvent"
                             Style="{StaticResource SegmentRadio}"
                             Checked="on_database_changed" />
                <RadioButton x:Name="radio_project_epds" GroupName="DataSource"
                             Content="Project EPDs"
                             Style="{StaticResource SegmentRadio}"
                             Checked="on_database_changed" />
              </StackPanel>
            </Border>
          </StackPanel>

        <!-- ── Row 1 · left: Scope (Revit material picker, SmartMatch-style) ─ -->
        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal"
                    VerticalAlignment="Center" Margin="0,0,0,8">
            <TextBlock Text="Scope:" FontWeight="SemiBold" FontSize="12"
                       VerticalAlignment="Center" Width="100" Margin="0,0,10,0" />
            <ComboBox x:Name="combo_scope" Width="230" Height="26" FontSize="11"
                      VerticalContentAlignment="Center"
                      SelectionChanged="on_scope_changed">
              <ComboBoxItem IsEnabled="False"
                            Background="{StaticResource AccentLightBrush}"
                            Foreground="{StaticResource AccentBrush}"
                            FontWeight="Bold" FontSize="10" Padding="8,5">
                <TextBlock Text="▸  ELEMENTS" />
              </ComboBoxItem>
              <ComboBoxItem x:Name="scope_pick_elements"    Content="  Pick Elements" />
              <ComboBoxItem x:Name="scope_elements_view"    Content="  All Elements in Active View" />
              <ComboBoxItem x:Name="scope_elements_project" Content="  All Elements in Project" />
              <ComboBoxItem IsEnabled="False"
                            Background="{StaticResource AccentLightBrush}"
                            Foreground="{StaticResource AccentBrush}"
                            FontWeight="Bold" FontSize="10" Padding="8,5">
                <TextBlock Text="▸  MATERIALS" />
              </ComboBoxItem>
              <ComboBoxItem x:Name="scope_pick_materials"    Content="  Pick Materials" />
              <ComboBoxItem x:Name="scope_materials_project" Content="  All Materials in Project" IsSelected="True" />
            </ComboBox>
          </StackPanel>

        <!-- ── Row 2 · left: Ground Truth. The path box lives in the * column
             so the left side shrinks/ellipsifies before the right is starved. -->
        <Grid Grid.Row="2" Grid.Column="0" VerticalAlignment="Center">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Ground Truth:" FontWeight="SemiBold" FontSize="12"
                     VerticalAlignment="Center" Width="100" Margin="0,0,10,0" />
          <Border Grid.Column="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                  CornerRadius="3" Background="{StaticResource SectionBg}"
                  Height="26" Padding="6,0" VerticalAlignment="Center" MinWidth="220">
            <TextBlock x:Name="text_groundtruth_path"
                       Text="(none — click Browse to choose)"
                       Foreground="{StaticResource SubtleFg}" FontSize="10"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />
          </Border>
          <Button Grid.Column="2" x:Name="btn_browse_groundtruth" Content="Browse…"
                  Style="{StaticResource SubtleButton}"
                  Padding="10,3" FontSize="11" Height="26" Margin="6,0,0,0"
                  Click="on_browse_groundtruth" />
        </Grid>

        <!-- ── Row 0 · right: Top + Min Score + Lang ───────────────── -->
        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,0,8">
            <TextBlock Text="Top:" FontWeight="SemiBold" FontSize="11"
                       VerticalAlignment="Center" Margin="0,0,6,0"
                       Foreground="{StaticResource SubtleFg}" />
            <ComboBox x:Name="combo_topn" Width="56" Height="26" FontSize="11"
                      SelectedIndex="1" Margin="0,0,14,0" VerticalContentAlignment="Center"
                      SelectionChanged="on_topn_changed">
              <ComboBoxItem Content="3" />
              <ComboBoxItem Content="5" />
              <ComboBoxItem Content="10" />
              <ComboBoxItem Content="20" />
            </ComboBox>

            <TextBlock Text="Min Score:" FontWeight="SemiBold" FontSize="11"
                       VerticalAlignment="Center" Margin="0,0,6,0"
                       Foreground="{StaticResource SubtleFg}" />
            <Slider x:Name="slider_threshold" Width="80" Minimum="0" Maximum="100"
                    Value="50" VerticalAlignment="Center"
                    ValueChanged="on_threshold_changed" />
            <TextBox x:Name="text_threshold" Text="50%" Width="38" TextAlignment="Right"
                     FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"
                     Margin="0,0,14,0" Foreground="{StaticResource AccentBrush}"
                     Background="Transparent" BorderThickness="0" Cursor="IBeam"
                     TextChanged="on_threshold_text_changed" />

            <TextBlock Text="Lang:" FontWeight="SemiBold" FontSize="11"
                       VerticalAlignment="Center" Margin="0,0,6,0"
                       Foreground="{StaticResource SubtleFg}" />
            <Border CornerRadius="4" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0">
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="radio_lang_de" GroupName="Language"
                             Content="DE"
                             Style="{StaticResource SegmentRadio}"
                             Checked="on_language_changed" />
                <RadioButton x:Name="radio_lang_en" GroupName="Language"
                             Content="EN" IsChecked="True"
                             Style="{StaticResource SegmentRadio}"
                             Checked="on_language_changed" />
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- BIM-context query enrichment. The single 'BIM context' checkbox
               applies the fixed best-combo field set (name + class +
               description + concrete grade + struct class - the universal
               winner from tools/ladder_modes.md) to the SEMANTIC / hybrid /
               reranker query; the BM25F leg always stays on the name and Regex
               is never enriched. When ON, each dense mode runs twice (name-only
               baseline + enriched) so the metrics table reads "before | after".
               Fuzzy ALSO runs twice - not because enrichment helps it (it does
               not), but so the lexical path is documented comprehensively and
               its noise is visible in the table. The per-field boxes below are
               hidden (Collapsed) - per-field experimentation now lives in the
               "Measure field value" dialog - but kept so the picker can reuse
               their tooltips and old settings migrate cleanly. -->
          <!-- ── Row 1 · right: BIM context ────────────────────────── -->
          <WrapPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal"
                     HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,0,8">
            <ToggleButton x:Name="chk_context" Content="BIM context"
                      Style="{StaticResource ToggleSwitch}"
                      VerticalAlignment="Center" Margin="0,0,12,0"
                      ToolTip="Enrich the query with the best-combo BIM context — name + class + description + concrete grade + struct class — from each material's ground-truth entry. The BM25F leg always stays on the name; Regex is never enriched. With this ON, each dense mode AND Fuzzy run twice and the table shows name-only | +BIM context per cell. Fuzzy is included to prove that enrichment adds noise to the lexical path."
                      Checked="on_context_changed" Unchecked="on_context_changed" />
            <CheckBox x:Name="chk_ctx_class" Content="+Class" FontSize="11" IsChecked="True"
                      Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,8,0"
                      ToolTip="Helps (✓). ÖKOBAUDAT classification path."
                      Checked="on_context_changed" Unchecked="on_context_changed" />
            <CheckBox x:Name="chk_ctx_description" Content="+Description" FontSize="11"
                      Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,8,0"
                      ToolTip="Helps (✓, recommended). The material's free-text description."
                      Checked="on_context_changed" Unchecked="on_context_changed" />
            <CheckBox x:Name="chk_ctx_concrete_grade" Content="+Concrete grade" FontSize="11"
                      Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,8,0"
                      ToolTip="Helps on concrete (✓). C-class from compressive strength."
                      Checked="on_context_changed" Unchecked="on_context_changed" />
            <CheckBox x:Name="chk_ctx_structural_class" Content="+Struct class" FontSize="11"
                      Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,8,0"
                      ToolTip="Neutral (~) on average; gives the reranker its best result. Part of the best combo."
                      Checked="on_context_changed" Unchecked="on_context_changed" />
            <CheckBox x:Name="chk_ctx_host_categories" Content="+Categories" FontSize="11"
                      Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,8,0"
                      ToolTip="Helps EN-semantic only; hurts hybrid + reranker and all of DE (~/⚠)."
                      Checked="on_context_changed" Unchecked="on_context_changed" />
            <CheckBox x:Name="chk_ctx_density" Content="+Density" FontSize="11"
                      Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,8,0"
                      ToolTip="Adds noise (⚠) — better kept as a deterministic filter."
                      Checked="on_context_changed" Unchecked="on_context_changed" />
            <CheckBox x:Name="chk_ctx_thermal_conductivity" Content="+λ" FontSize="11"
                      Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,8,0"
                      ToolTip="Adds noise (⚠) — better kept as a deterministic filter."
                      Checked="on_context_changed" Unchecked="on_context_changed" />
            <CheckBox x:Name="chk_ctx_host_types" Content="+Host types" FontSize="11"
                      Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,0,0"
                      ToolTip="Adds noise (⚠), especially dimensional strings."
                      Checked="on_context_changed" Unchecked="on_context_changed" />
          </WrapPanel>

          <!-- ── Row 2 · right: Measure + Run buttons. Run mode is chosen via the
               radio next to each results row; btn_run's Content is set by
               _update_run_button_label(). -->
          <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal"
                      HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button x:Name="btn_measure_fields" Content="Measure field value"
                    Style="{StaticResource RoundedButton}"
                    Height="28" Padding="12,0" Margin="0,0,8,0"
                    ToolTip="Re-measure the value of each BIM-context field on a new project. Opens a dialog to pick which fields and which dense modes (semantic / hybrid / reranker) to test, then ranks each cumulative field set by MRR / Recall@K against the loaded ground truth. May take a few minutes."
                    Click="on_measure_fields_click" />
            <Button x:Name="btn_run" Content="▶  Run Fuzzy Match"
                    Style="{StaticResource RoundedButton}"
                    Height="28" Padding="14,0"
                    Click="on_run_click" />
          </StackPanel>
      </Grid>
    </Border>

    <!-- ── RECALL@K METRICS DASHBOARD ─────────────────────────────── -->
    <Border Grid.Row="1" Background="{StaticResource SectionBg}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
            Padding="16,10">
      <Grid>
        <!-- Metrics table + scope/status line (per-row Show radios live in col 11 of the inner Grid) -->
        <StackPanel Orientation="Vertical">

          <!-- Metrics table: 12 cols × 6 rows - R@K (1-6) | MRR (8) | Time (10); separators at 7/9; Col 11 = per-row mode-selection radio -->
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="130" />    <!-- 0  mode label (wide enough for "Semantic + Rerank") -->
              <ColumnDefinition Width="0.8*" />   <!-- 1  R@1   -->
              <ColumnDefinition Width="0.8*" />   <!-- 2  R@3   -->
              <ColumnDefinition Width="0.8*" />   <!-- 3  R@5   -->
              <ColumnDefinition Width="0.8*" />   <!-- 4  R@10  -->
              <ColumnDefinition Width="0.8*" />   <!-- 5  R@20  -->
              <ColumnDefinition Width="0.8*" />   <!-- 6  R@All -->
              <ColumnDefinition Width="Auto" />   <!-- 7  group separator -->
              <ColumnDefinition Width="1.4*" />   <!-- 8  MRR -->
              <ColumnDefinition Width="Auto" />   <!-- 9  group separator -->
              <ColumnDefinition Width="*" />      <!-- 10 Time -->
              <ColumnDefinition Width="Auto" />   <!-- 11 per-row Show radio -->
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />   <!-- 0 header -->
              <!-- Mode rows are a FIXED height so the table layout never
                   reflows: the cells reserve room for two lines (value +
                   correct-%/CI) at all times and VerticalAlignment=Center
                   keeps the lone "-" (or the computed numbers) centred.
                   Only the text changes after a run, not the row geometry. -->
              <RowDefinition Height="38" />     <!-- 1 Regex -->
              <RowDefinition Height="38" />     <!-- 2 Fuzzy -->
              <RowDefinition Height="38" />     <!-- 3 Semantic -->
              <RowDefinition Height="38" />     <!-- 4 Hybrid -->
              <RowDefinition Height="38" />     <!-- 5 Hybrid+Rerank -->
              <RowDefinition Height="38" />     <!-- 6 Semantic+Rerank (ablation) -->
            </Grid.RowDefinitions>

            <!-- ── Header row ──────────────────────────────────────── -->
            <TextBlock Grid.Row="0" Grid.Column="1" Text="R@1"
                       HorizontalAlignment="Center" FontSize="10"
                       FontWeight="SemiBold" Foreground="{StaticResource SubtleFg}"
                       Margin="0,0,0,4" />
            <TextBlock Grid.Row="0" Grid.Column="2" Text="R@3"
                       HorizontalAlignment="Center" FontSize="10"
                       FontWeight="SemiBold" Foreground="{StaticResource SubtleFg}"
                       Margin="0,0,0,4" />
            <TextBlock Grid.Row="0" Grid.Column="3" Text="R@5"
                       HorizontalAlignment="Center" FontSize="10"
                       FontWeight="SemiBold" Foreground="{StaticResource SubtleFg}"
                       Margin="0,0,0,4" />
            <TextBlock Grid.Row="0" Grid.Column="4" Text="R@10"
                       HorizontalAlignment="Center" FontSize="10"
                       FontWeight="SemiBold" Foreground="{StaticResource SubtleFg}"
                       Margin="0,0,0,4" />
            <TextBlock Grid.Row="0" Grid.Column="5" Text="R@20"
                       HorizontalAlignment="Center" FontSize="10"
                       FontWeight="SemiBold" Foreground="{StaticResource SubtleFg}"
                       Margin="0,0,0,4" />
            <TextBlock Grid.Row="0" Grid.Column="6" Text="R@All"
                       HorizontalAlignment="Center" FontSize="10"
                       FontWeight="SemiBold" Foreground="{StaticResource SubtleFg}"
                       Margin="0,0,0,4" />
            <TextBlock Grid.Row="0" Grid.Column="8" Text="MRR"
                       HorizontalAlignment="Center" FontSize="10"
                       FontWeight="SemiBold" Foreground="{StaticResource SubtleFg}"
                       Margin="0,0,0,4"
                       ToolTip="Mean Reciprocal Rank — 1 / (rank of the first acceptable EPD), averaged over all queries. A single-number rank-quality score in [0, 1]; higher = the correct EPD surfaces nearer the top. Unlike Recall, it is sensitive to WHERE the hit lands, not just whether it appears." />
            <TextBlock Grid.Row="0" Grid.Column="10" Text="Time"
                       HorizontalAlignment="Center" FontSize="10"
                       FontWeight="SemiBold" Foreground="{StaticResource SubtleFg}"
                       Margin="0,0,0,4"
                       ToolTip="Per-query search-loop time of ONE pass with the model + reranker already warm — NOT the full click-to-result wall-clock. With BIM context on, each mode runs two passes (name-only baseline + enriched); only the enriched pass is shown, and the timer excludes one-time model/sidecar warm-up and post-run rendering (CIs, McNemar, grid). Hover a value for that run's breakdown. This warm, single-pass number is the per-query latency you'd see in production." />

            <!-- ── Vertical group separators (R@K ‖ MRR ‖ Time) ── -->
            <Border Grid.Row="0" Grid.RowSpan="6" Grid.Column="7" Width="1"
                    Background="{StaticResource BorderBrush}" Margin="6,0" />
            <Border Grid.Row="0" Grid.RowSpan="6" Grid.Column="9" Width="1"
                    Background="{StaticResource BorderBrush}" Margin="6,0" />

            <!-- ── Regex row ───────────────────────────────────────── -->
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Regex"
                       FontWeight="SemiBold" FontSize="12"
                       VerticalAlignment="Center" Foreground="#374151" />
            <StackPanel Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2">
              <TextBlock x:Name="text_regex_r1_pct"  Text="—" HorizontalAlignment="Center"
                         FontSize="13" FontWeight="Bold" Foreground="{StaticResource SubtleFg}" />
              <TextBlock x:Name="text_regex_r1_frac" Text=""  HorizontalAlignment="Center"
                         FontSize="10" Foreground="{StaticResource AccentBrush}" Visibility="Collapsed" />
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2">
