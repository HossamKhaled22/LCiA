                       Foreground="#374151" Margin="0,0,0,3" />
            <TextBlock x:Name="text_mcnemar_note" Text="" TextWrapping="Wrap"
                       FontSize="10.5" FontStyle="Italic"
                       Foreground="{StaticResource SubtleFg}" Margin="0,0,0,0" />
          </StackPanel>
        </StackPanel>

      </Grid>
    </Border>

    <!-- ── RESULTS ────────────────────────────────────────────────── -->
    <Grid Grid.Row="2" Margin="14,10,14,6">
      <Border BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1" CornerRadius="4"
              Background="{StaticResource SectionBg}">
        <Grid>
          <!-- Placeholder shown when no results yet -->
          <StackPanel x:Name="panel_placeholder" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Ready to validate" Foreground="{StaticResource SubtleFg}"
                       FontSize="14" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,0,0,8" />
            <TextBlock Text="Pick a Scope and Ground Truth above, choose a mode via the radio next to its row, then click ▶ Run."
                       Foreground="#9CA3AF" FontSize="12" FontStyle="Italic"
                       HorizontalAlignment="Center" Margin="0,0,0,20" />
          </StackPanel>

          <!-- Grouped DataGrid (one Expander group per query, candidate rows inside) -->
          <DataGrid x:Name="datagrid_results"
                    Visibility="Collapsed"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    CanUserAddRows="False" CanUserDeleteRows="False"
                    CanUserReorderColumns="False"
                    HeadersVisibility="Column"
                    GridLinesVisibility="All"
                    SelectionMode="Single" SelectionUnit="FullRow"
                    BorderThickness="0"
                    AlternatingRowBackground="#F9FAFB"
                    RowBackground="White"
                    ColumnHeaderHeight="32"
                    FontSize="11">

            <DataGrid.ColumnHeaderStyle>
              <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="#F0F4F8" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="0,0,1,1" />
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
              </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.GroupStyle>
              <GroupStyle>
                <GroupStyle.ContainerStyle>
                  <Style TargetType="{x:Type GroupItem}">
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="{x:Type GroupItem}">
                          <Expander IsExpanded="True"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,0,0,1">
                            <Expander.Header>
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="*" />
                                  <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="4,6">
                                  <TextBlock Text="{Binding Path=Name}"
                                             Foreground="{StaticResource AccentBrush}"
                                             FontWeight="Bold" FontSize="12"
                                             VerticalAlignment="Center" />
                                  <TextBlock Foreground="{StaticResource SubtleFg}"
                                             FontSize="11" VerticalAlignment="Center"
                                             Margin="10,0,0,0">
                                    <TextBlock.Text>
                                      <Binding Path="Items[0].HeaderSubtitle" />
                                    </TextBlock.Text>
                                  </TextBlock>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Margin="0,6,16,6"
                                           Foreground="{StaticResource SubtleFg}"
                                           FontSize="11" VerticalAlignment="Center">
                                  <TextBlock.Text>
                                    <Binding Path="Items[0].HeaderHitText" />
                                  </TextBlock.Text>
                                </TextBlock>
                              </Grid>
                            </Expander.Header>
                            <ItemsPresenter />
                          </Expander>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </GroupStyle.ContainerStyle>
              </GroupStyle>
            </DataGrid.GroupStyle>

            <DataGrid.Columns>
              <DataGridTextColumn Header="★"     Binding="{Binding HitMarker}" Width="32" />
              <DataGridTextColumn Header="Rank"  Binding="{Binding Rank}"      Width="55" />
              <DataGridTextColumn Header="Score" Binding="{Binding ScoreDisplay}" Width="72">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="ToolTip" Value="{Binding ScoreTooltip}" />
                    <Setter Property="ToolTipService.InitialShowDelay" Value="300" />
                    <Setter Property="ToolTipService.ShowDuration" Value="20000" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="Name"  Binding="{Binding MatchName}" Width="2*" MinWidth="180">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="TextWrapping" Value="Wrap" />
                    <Setter Property="Margin" Value="4,3" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="Classification" Binding="{Binding Classification}" Width="1.5*" MinWidth="140">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="TextWrapping" Value="Wrap" />
                    <Setter Property="Margin" Value="4,3" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="UUID" Binding="{Binding UUID}" Width="1.2*" MinWidth="100">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="Margin" Value="4,3" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>
    </Grid>

    <!-- ── FOOTER ─────────────────────────────────────────────────── -->
    <Border Grid.Row="3" Background="{StaticResource HeaderBg}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
            Padding="16,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="text_status" Grid.Column="0"
                   Text="Ready – pick scope and ground truth, then run."
                   Foreground="{StaticResource SubtleFg}" FontSize="11"
                   VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="btn_toggle_skipped" Content="Hide skipped"
                  Style="{StaticResource SubtleButton}"
                  Click="on_toggle_skipped" Margin="0,0,6,0" Padding="8,4" FontSize="11"
                  ToolTip="Show or hide the skipped material groups (ground-truth label ≠ match, or not in the ground-truth file) in the results list. Hiding them leaves only the scored materials. Does not affect the metrics above — those are always computed on matched materials only." />
          <Button Content="▸ Expand"   Style="{StaticResource SubtleButton}"
                  Click="on_expand_all"   Margin="0,0,6,0" Padding="8,4" FontSize="11" />
          <Button Content="▾ Collapse" Style="{StaticResource SubtleButton}"
                  Click="on_collapse_all" Margin="0,0,6,0" Padding="8,4" FontSize="11" />
          <Button x:Name="btn_export" Content="⤓ Export"
                  Style="{StaticResource SubtleButton}"
                  Click="on_export_results" Padding="8,4" FontSize="11"
                  ToolTip="Export the current results to a Markdown report." />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
