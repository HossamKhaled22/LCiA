<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Extract Context"
        Width="980" Height="640"
        MinWidth="780" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="True">

  <Window.Resources>
    <SolidColorBrush x:Key="AccentBrush"      Color="#0078D4" />
    <SolidColorBrush x:Key="AccentLightBrush" Color="#E8F2FC" />
    <SolidColorBrush x:Key="HeaderBg"         Color="#F5F6F7" />
    <SolidColorBrush x:Key="BorderBrush"      Color="#D1D5DB" />
    <SolidColorBrush x:Key="SectionBg"        Color="#FFFFFF" />
    <SolidColorBrush x:Key="SubtleFg"         Color="#6B7280" />

    <Style x:Key="RoundedButton" TargetType="Button">
      <Setter Property="Background"      Value="{StaticResource AccentBrush}" />
      <Setter Property="Foreground"      Value="White" />
      <Setter Property="FontWeight"      Value="SemiBold" />
      <Setter Property="FontSize"        Value="12" />
      <Setter Property="Padding"         Value="14,6" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor"          Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SubtleButton" TargetType="Button">
      <Setter Property="Background"      Value="Transparent"/>
      <Setter Property="Foreground"      Value="{StaticResource AccentBrush}"/>
      <Setter Property="FontWeight"      Value="SemiBold"/>
      <Setter Property="FontSize"        Value="12"/>
      <Setter Property="Padding"         Value="12,6"/>
      <Setter Property="BorderBrush"     Value="{StaticResource AccentBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor"          Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentLightBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SegmentRadio" TargetType="RadioButton">
      <Setter Property="FontSize"  Value="11.5"/>
      <Setter Property="Margin"    Value="0"/>
      <Setter Property="Padding"   Value="12,7"/>
      <Setter Property="Cursor"    Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="bd" Background="Transparent"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1,1,0,1"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentLightBrush}"/>
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsChecked"   Value="True"/>
                  <Condition Property="IsMouseOver" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentBrush}"/>
                <Setter TargetName="bd" Property="Opacity"    Value="0.88"/>
              </MultiTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- DataGrid cell: remove selection highlight -->
    <Style x:Key="PropCellStyle" TargetType="DataGridCell">
      <Setter Property="BorderThickness"  Value="0"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Padding"          Value="0"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background"  Value="Transparent"/>
          <Setter Property="Foreground"  Value="Black"/>
          <Setter Property="BorderBrush" Value="Transparent"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid Margin="0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ── HEADER ── -->
    <Border Grid.Row="0" Background="{StaticResource HeaderBg}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
            Padding="16,10">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="Scope:" FontWeight="SemiBold" FontSize="12"
                   VerticalAlignment="Center" Margin="0,0,10,0"/>
        <Border CornerRadius="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="rb_active_view"    GroupName="Scope" Content="Active View"
                         IsChecked="True" Style="{StaticResource SegmentRadio}"
                         Checked="radio_scope_changed"/>
            <RadioButton x:Name="rb_entire_project" GroupName="Scope" Content="Entire Project"
                         Style="{StaticResource SegmentRadio}"
                         Checked="radio_scope_changed"/>
            <RadioButton x:Name="rb_by_category"    GroupName="Scope" Content="By Category"
                         Style="{StaticResource SegmentRadio}"
                         Checked="radio_scope_changed"/>
            <RadioButton x:Name="rb_pick_elements"  GroupName="Scope" Content="Pick Elements"
                         Style="{StaticResource SegmentRadio}"
                         Checked="radio_scope_changed"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>

    <!-- ── CONTENT ── -->
    <Grid Grid.Row="1" Margin="14,10,14,6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="col_categories" Width="0" MaxWidth="320"/>
        <ColumnDefinition x:Name="col_splitter"   Width="0"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- ── Category panel (shown only for By Category scope) ── -->
      <Border x:Name="grid_category_filter" Grid.Column="0"
              BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
              CornerRadius="4" Background="{StaticResource SectionBg}"
              Visibility="Collapsed">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="Filter Categories" FontWeight="SemiBold"
                     FontSize="12" Margin="10,8,10,6"/>
          <DockPanel Grid.Row="1" LastChildFill="True" Margin="10,0,10,6">
            <Button x:Name="btn_searchmode" Width="36" Height="26" Margin="0,0,6,0"
                    Content="AZ" FontSize="12" FontWeight="Bold" Padding="0"
                    ToolTip="Toggle: AZ = fuzzy, .* = regex"
                    Style="{StaticResource SubtleButton}" DockPanel.Dock="Left"
                    Click="toggle_search_mode"/>
            <TextBox x:Name="textbox_category_filter" Height="26"
                     VerticalContentAlignment="Center" FontSize="11"
                     TextChanged="textbox_category_filter_updated"/>
          </DockPanel>
          <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="0,1,0,0" Margin="0,4,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="stackpanel_categories" Margin="8">
                <CheckBox x:Name="checkbox_all_categories" Content="All Categories"
                          IsChecked="False" FontWeight="SemiBold" Margin="0,0,0,8"
                          Checked="checkbox_all_categories_changed"
                          Unchecked="checkbox_all_categories_changed"/>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
      </Border>

      <GridSplitter x:Name="grid_categories_splitter" Grid.Column="1" Width="6"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Background="Transparent" Visibility="Collapsed"/>

      <!-- ── Right panel: property selector ── -->
      <Border Grid.Column="2" BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1" CornerRadius="4" Background="{StaticResource SectionBg}">
        <Grid Margin="10,8,10,8">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- toolbar: label + quick buttons -->
            <RowDefinition Height="*"/>      <!-- DataGrid -->
            <RowDefinition Height="Auto"/>   <!-- legend + output path -->
          </Grid.RowDefinitions>

          <!-- ── Toolbar ── -->
          <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
            <TextBlock Text="Properties to Export" FontWeight="SemiBold" FontSize="12"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="text_selected_count"
                       Foreground="{StaticResource SubtleFg}" FontSize="11"
                       VerticalAlignment="Center" Margin="8,0,0,0"/>
          </StackPanel>

          <!-- ── Property DataGrid ── -->
          <DataGrid x:Name="dg_properties" Grid.Row="1"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    CanUserReorderColumns="False"
                    CanUserSortColumns="True"
                    IsReadOnly="False"
                    RowHeight="34"
                    ColumnHeaderHeight="35"
                    FontSize="11"
                    SelectionMode="Single"
                    SelectionUnit="Cell"
                    HeadersVisibility="Column"
                    GridLinesVisibility="Horizontal"
                    HorizontalGridLinesBrush="#F3F4F6"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    AlternatingRowBackground="#F9FAFB"
                    RowBackground="White"
                    CellStyle="{StaticResource PropCellStyle}"
                    ScrollViewer.CanContentScroll="False"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    VirtualizingStackPanel.IsVirtualizing="True">

            <DataGrid.GroupStyle>
              <GroupStyle>
                <GroupStyle.ContainerStyle>
                  <Style TargetType="{x:Type GroupItem}">
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="{x:Type GroupItem}">
                          <Expander IsExpanded="True"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,0,0,1">
                            <Expander.Header>
                              <StackPanel Orientation="Horizontal" Margin="4,6">
                                <TextBlock Text="{Binding Path=Name}"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontWeight="Bold" FontSize="12"
                                           VerticalAlignment="Center"/>
                                <TextBlock Foreground="{StaticResource SubtleFg}"
                                           FontSize="11" VerticalAlignment="Center"
                                           Margin="8,0,0,0"
                                           Text="{Binding Path=ItemCount, StringFormat='({0})'}"/>
                              </StackPanel>
                            </Expander.Header>
                            <ItemsPresenter/>
                          </Expander>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </GroupStyle.ContainerStyle>
              </GroupStyle>
            </DataGrid.GroupStyle>

            <DataGrid.ColumnHeaderStyle>
              <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background"                Value="#F0F4F8"/>
                <Setter Property="BorderBrush"               Value="{StaticResource BorderBrush}"/>
                <Setter Property="BorderThickness"           Value="0,0,1,1"/>
                <Setter Property="Padding"                   Value="6,4"/>
                <Setter Property="FontWeight"                Value="SemiBold"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment"  Value="Center"/>
              </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.Columns>

              <!-- ★ recommended star -->
              <DataGridTemplateColumn Width="26" MinWidth="26" SortMemberPath="Recommended"
                                      CanUserResize="False" IsReadOnly="True">
                <DataGridTemplateColumn.Header>
                  <TextBlock Text="&#9733;" Foreground="#D97706" FontSize="12"
                             HorizontalAlignment="Center" ToolTip="★ = Recommended for LLM / vector matching"/>
                </DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding StarText}" Foreground="#D97706"
                               FontSize="13" HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <!-- Export checkbox -->
              <DataGridTemplateColumn Header="Export" Width="55" MinWidth="50"
                                      SortMemberPath="IsSelected"
                                      CanUserResize="False" IsReadOnly="False">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay,
                                          UpdateSourceTrigger=PropertyChanged}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Checked="on_checkbox_changed" Unchecked="on_checkbox_changed"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>

              <!-- Property display name -->
              <DataGridTextColumn Header="Property" Width="1.4*" MinWidth="110" IsReadOnly="True"
                                  Binding="{Binding DisplayName}">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="FontWeight"        Value="SemiBold"/>
                    <Setter Property="FontSize"          Value="11"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="Margin"            Value="4,3"/>
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>

              <!-- Example value -->
              <DataGridTextColumn Header="Example" Width="1*" MinWidth="90" IsReadOnly="True"
                                  Binding="{Binding Example}">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="FontFamily"        Value="Consolas"/>
                    <Setter Property="FontSize"          Value="10"/>
                    <Setter Property="Foreground"        Value="#374151"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="Margin"            Value="4,3"/>
                    <Setter Property="TextTrimming"      Value="CharacterEllipsis"/>
                    <Setter Property="ToolTip"           Value="{Binding Example}"/>
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>

              <!-- Description -->
              <DataGridTextColumn Header="Description" Width="2.6*" MinWidth="150" IsReadOnly="True"
                                  Binding="{Binding Description}">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="FontSize"          Value="11"/>
                    <Setter Property="Foreground"        Value="#4B5563"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="Margin"            Value="4,3"/>
                    <Setter Property="TextTrimming"      Value="CharacterEllipsis"/>
                    <Setter Property="ToolTip"           Value="{Binding Description}"/>
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>

            </DataGrid.Columns>
          </DataGrid>

          <!-- ── Legend + output path ── -->
          <StackPanel Grid.Row="2" Margin="0,6,0,0">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
              <TextBlock Text="&#9733;" Foreground="#D97706" FontSize="11" Margin="0,0,4,0"
                         VerticalAlignment="Center"/>
              <TextBlock Foreground="{StaticResource SubtleFg}" FontSize="10"
                         VerticalAlignment="Center"
                         Text="Recommended for vector search / LLM matching (based on ÖKOBAUDAT data analysis). Hover descriptions for details."/>
            </StackPanel>
            <TextBlock x:Name="text_output_path" FontSize="10"
                       Foreground="{StaticResource SubtleFg}" TextWrapping="Wrap"/>
          </StackPanel>

        </Grid>
      </Border>
    </Grid>

    <!-- ── FOOTER ── -->
    <Border Grid.Row="2" Background="{StaticResource HeaderBg}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
            Padding="16,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="text_status" Grid.Column="0"
                   Text="Select a scope, choose properties to export, then click Extract Context."
                   Foreground="{StaticResource SubtleFg}" FontSize="11" VerticalAlignment="Center"/>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="▸ Expand" Style="{StaticResource SubtleButton}" Padding="8,4" FontSize="11"
                  Click="on_expand_all" Margin="0,0,6,0"/>
          <Button Content="▾ Collapse" Style="{StaticResource SubtleButton}" Padding="8,4" FontSize="11"
                  Click="on_collapse_all" Margin="0,0,6,0"/>
          <Button x:Name="btn_recommended" Content="&#9733; Recommended"
                  Style="{StaticResource SubtleButton}" Padding="8,4" FontSize="11"
                  Click="on_recommended_click"
                  ToolTip="Select only recommended fields (best signal-to-noise for LLM/vector matching)"
                  Margin="0,0,6,0"/>
          <Button x:Name="btn_select_all" Content="Select All"
                  Style="{StaticResource SubtleButton}" Padding="8,4" FontSize="11"
                  Click="on_select_all_click" Margin="0,0,6,0"/>
          <Button x:Name="btn_deselect_all" Content="Deselect All"
                  Style="{StaticResource SubtleButton}" Padding="8,4" FontSize="11"
                  Click="on_deselect_all_click" Margin="0,0,12,0"/>
          <Button x:Name="btn_extract" Content="▶  Extract Context"
                  Style="{StaticResource RoundedButton}" Height="30" Padding="14,0"
                  Click="on_extract_click"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
